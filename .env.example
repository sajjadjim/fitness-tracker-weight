# ==========================================
# FitTrack — Smart Weight & BMI Tracker
# Environment Configuration
# ==========================================

# 1. MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fittrack?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fittrack?retryWrites=true&w=majority

# 2. Firebase Client Configuration (from Firebase Console -> Project Settings -> General -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# 3. Firebase Admin SDK Configuration (from Firebase Console -> Project Settings -> Service accounts)
# Option A: Individual credentials (recommended for Vercel deployment)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# IMPORTANT: When pasting private key in Vercel, enclose in quotes and ensure newlines \n are preserved
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Or as a single JSON string (alternative)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# 4. App URL (optional for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
